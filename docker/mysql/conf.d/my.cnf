# 開発用 MySQL 8.4 の設定（compose.yaml から /etc/mysql/conf.d に読み込み専用でマウント）
#
# MySQL 8.0 時代の設定から消したもの:
# - default_authentication_plugin  … 8.4 で廃止。残っていると mysqld が起動しない
# - default-storage-engine=INNODB  … 8.0 以降は最初から InnoDB
# - explicit-defaults-for-timestamp … 8.0 以降は最初から ON
# - general-log                     … 全クエリをファイルに書き続ける。SQL は Rails のログで見られる

[mysqld]
character-set-server=utf8mb4
# 既存のテーブル（db/schema.rb）と同じ照合順序にそろえる
collation-server=utf8mb4_unicode_ci

[mysql]
default-character-set=utf8mb4

[client]
default-character-set=utf8mb4
