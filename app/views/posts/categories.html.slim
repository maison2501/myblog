= render partial: 'shared/page_title', locals: { page_title: "Categories" }
header.masthead
  .container.position-relative.px-4.px-lg-5
    .row.gx-4.gx-lg-5.justify-content-center
      .col-md-10.col-lg-8.col-xl-7
        .site-heading
          h1
            | Categories
article.mb-4
  .container.px-4.px-lg-5
    .row.gx-4.gx-lg-5.justify-content-center
      .col-md-10.col-lg-8.col-xl-7
        - @tag_list.each do |list|
          .post-preview
            h2.post-title
              = link_to list.tag_name, tag_posts_path(tag_id: list.id)
          hr.my-4
        br