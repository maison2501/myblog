- provide :title, @post.title
= render "shared/masthead", heading: @post.title, meta: "Posted on #{l(@post.created_at, format: :long)}"
= render layout: "shared/content" do
  - if @post.tags.any?
    p
      strong.me-2 Category:
      - @post.tags.each do |tag|
        = link_to tag.tag_name, tag_posts_path(tag), class: "me-2"
  .post-body
    = markdown(@post.content)
  - if admin?
    hr.my-4
    .d-flex.gap-3.align-items-center
      = link_to "編集する", edit_post_path(@post), class: "btn btn-primary"
      = button_to "削除する", @post, method: :delete, class: "btn btn-outline-danger",
        form: { data: { turbo_confirm: "「#{@post.title}」を削除しますか？" } }
