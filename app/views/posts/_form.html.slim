= javascript_import_module_tag "controllers/article"
= form_with(model: post) do |form|
  - if post.errors.any?
    div[style="color: red"]

    h2
      = pluralize(post.errors.count, "error")
      |  prohibited this post from being saved:
    ul
      - post.errors.each do |error|
        li
          = error.full_message
  .field
    = form.label :title, style: "display: block"
    = form.text_field :title, placeholder: "What is about?", size: "40"
  .field
    = form.label :tag_name, style: "display: block"
    = form.text_field :tag_name, value: @tag_list
  .field
    = form.label :content, style: "display: block"
    = form.text_area :content, size: "70x40"
    /, id: "editor"
  .actions
    = form.submit