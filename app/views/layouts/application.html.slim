doctype html
html lang="ja"
  head
    meta charset="utf-8"
    meta name="viewport" content="width=device-width, initial-scale=1"
    title = full_title(yield(:title))
    = csrf_meta_tags
    = csp_meta_tag
    link rel="icon" href="/favicon.ico"
    link rel="apple-touch-icon" href="/apple-touch-icon.png"
    link href="https://fonts.googleapis.com/css?family=Lora:400,700,400italic,700italic" rel="stylesheet"
    link href="https://fonts.googleapis.com/css?family=Open+Sans:300italic,400italic,600italic,700italic,800italic,400,300,600,700,800" rel="stylesheet"
    / Bootstrap 本体（CDN）。integrity は「CDN から届いたファイルが改ざんされていないか」をブラウザに確かめさせるハッシュ
    link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous" data-turbo-track="reload"
    = stylesheet_link_tag "theme", "data-turbo-track": "reload"
    = stylesheet_link_tag "syntax", "data-turbo-track": "reload"
    = stylesheet_link_tag "post_body", "data-turbo-track": "reload"
    - if admin?
      / 記事編集用の Markdown エディタ（ログイン中だけ読み込む）
      link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/easymde@2.18.0/dist/easymde.min.css" integrity="sha384-uqD/OYCNfagd1EgXMgl5QedTD5K+B3e9b8GYo/41t7+Serf7CBxvl+tU1gHd+qd1" crossorigin="anonymous" data-turbo-track="reload"
      script src="https://cdn.jsdelivr.net/npm/easymde@2.18.0/dist/easymde.min.js" integrity="sha384-KtB38COewxfrhJxoN2d+olxJAeT08LF8cVZ6DQ8Poqu89zIptqO6zAXoIxpGNWYE" crossorigin="anonymous" data-turbo-track="reload"
    = javascript_importmap_tags
  body
    nav#mainNav.navbar.navbar-expand-lg.navbar-light data-controller="navbar"
      .container.px-4.px-lg-5
        = link_to site_title, root_path, class: "navbar-brand"
        / スマホ幅ではメニューを折りたたむ
        button.navbar-toggler type="button" aria-controls="navbarResponsive" aria-expanded="false" aria-label="メニューを開く" data-action="navbar#toggle" data-navbar-target="toggler"
          | Menu
        #navbarResponsive.collapse.navbar-collapse data-navbar-target="menu"
          ul.navbar-nav.ms-auto.py-4.py-lg-0
            li.nav-item = link_to "Home", root_path, class: "nav-link px-lg-3 py-3 py-lg-4"
            li.nav-item = link_to "Categories", categories_path, class: "nav-link px-lg-3 py-3 py-lg-4"
            - if admin?
              li.nav-item = link_to "New Post", new_post_path, class: "nav-link px-lg-3 py-3 py-lg-4"
              li.nav-item = link_to "Logout", logout_path, data: { turbo_method: :delete }, class: "nav-link px-lg-3 py-3 py-lg-4"

    = yield

    / 「投稿しました」などのお知らせを画面右下に出す
    - if flash.any?
      .position-fixed.bottom-0.end-0.p-3 style="z-index: 1080"
        - flash.each do |type, message|
          div class="alert #{type == 'alert' ? 'alert-danger' : 'alert-success'} shadow-sm" role="alert" = message

    footer.border-top
      .container.px-4.px-lg-5
        .row.gx-4.gx-lg-5.justify-content-center
          .col-md-10.col-lg-8.col-xl-7
            .small.text-center.text-muted.fst-italic
              | Copyright © #{site_title} #{Date.current.year}
